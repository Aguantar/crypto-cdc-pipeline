    {
      "id": "cc6f2c73-2ff0-448b-851a-3df3e1f4eb81",
      "name": "ClickHouse - Pipeline Status",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -704,
        64
      ],
      "parameters": {
        "url": "http://cdc-clickhouse:8123/",
        "body": "SELECT (SELECT count() FROM cdc_pipeline.upbit_market_events WHERE kind = 'transition' AND observed_at >= now() - INTERVAL 1 MINUTE) as anomaly_count, (SELECT count() FROM cdc_pipeline.crypto_trades WHERE source_ts >= now() - INTERVAL 5 MINUTE) as recent_trades, (SELECT count() FROM cdc_pipeline.crypto_trades) as total_trades, (SELECT groupArray(concat(flag, ' ', if(state = 1, '지정', '해제'), ' ', market)) FROM (SELECT flag, state, market FROM cdc_pipeline.upbit_market_events WHERE kind = 'transition' AND observed_at >= now() - INTERVAL 1 MINUTE ORDER BY observed_at DESC LIMIT 10)) as alert_details FORMAT JSON",
        "method": "POST",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "contentType": "raw",
        "authentication": "genericCredentialType",
        "rawContentType": "text/plain",
        "genericAuthType": "httpBasicAuth"
      },
      "credentials": {
        "httpBasicAuth": {
          "id": "chn8nreaderbasic",
          "name": "ClickHouse n8n_reader (basic)"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "2e0efa12-d854-42b1-9a98-ba7a1c830b5d",
      "name": "Parse & Combine",
      "type": "n8n-nodes-base.code",
      "position": [
        -464,
        160
      ],
      "parameters": {
        "jsCode": "const resp = $('ClickHouse - Pipeline Status').item.json;\nconst status = resp.data ? resp.data[0] : {};\n\nconst anomalyCount = parseInt(status.anomaly_count || '0');\nconst recentTrades = parseInt(status.recent_trades || '0');\nconst totalTrades = parseInt(status.total_trades || '0');\nconst pipelineStale = recentTrades === 0;\n\nconst details = status.alert_details || [];\nconst alertSummary = details.map(d => '• ' + d).join('\\n');\n\nconst now = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().replace('T', ' ').substring(0, 19);\n\nconst fmt = (n) => n.toLocaleString('ko-KR');\n\nreturn [{\n  json: {\n    anomaly_count: anomalyCount,\n    anomaly_count_fmt: fmt(anomalyCount),\n    recent_trades: recentTrades,\n    recent_trades_fmt: fmt(recentTrades),\n    total_trades: totalTrades,\n    total_trades_fmt: fmt(totalTrades),\n    pipeline_stale: pipelineStale,\n    alert_summary: alertSummary,\n    timestamp: now,\n    has_anomaly: anomalyCount > 0,\n    has_alert: anomalyCount > 0 || pipelineStale,\n    dashboard_url: 'https://<내-도메인>/d/cdc-pipeline-main/cdc-crypto-realtime-pipeline?orgId=1&refresh=10s'\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "07ed46a5-174d-4528-84b2-894bb0317bb5",
      "name": "IF Anomaly Detected",
      "type": "n8n-nodes-base.if",
      "position": [
        -240,
        64
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
