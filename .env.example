# .env.example - 실제 값은 .env 에 두고 커밋하지 않는다.
# cp .env.example .env 후 값을 채운다.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
GRAFANA_PASSWORD=
# Airflow
AIRFLOW_POSTGRES_USER=
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_POSTGRES_DB=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
CLICKHOUSE_READONLY_USER=
CLICKHOUSE_READONLY_PASSWORD=
# ClickHouse 접근 통제 (2026-09-17, docs/21): 네트워크 클라이언트는 인증 필수. default 는 컨테이너 로컬 전용으로 축소
CLICKHOUSE_PIPELINE_USER=
CLICKHOUSE_PIPELINE_PASSWORD=
CLICKHOUSE_N8N_USER=
CLICKHOUSE_N8N_PASSWORD=
CLICKHOUSE_DEFAULT_PASSWORD=
CLICKHOUSE_ICEPUSH_USER=
CLICKHOUSE_ICEPUSH_PASSWORD=
LEDGER_MYSQL_PASSWORD=
BINANCE_API_KEY=
PRODUCER_MYSQL_PASSWORD=
# Grafana 데모 공개용 ClickHouse 계정 (2026-09-20): cdc_pipeline 읽기 + 대시보드가 쓰는 system 표만.
# readonly=1 은 주지 않는다 — Grafana ClickHouse 플러그인이 세션 설정을 걸어서 500 이 난다. 쓰기 차단은 GRANT 로 한다.
CLICKHOUSE_GRAFANA_PUBLIC_USER=
CLICKHOUSE_GRAFANA_PUBLIC_PASSWORD=
