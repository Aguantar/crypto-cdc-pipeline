# 부팅 때 DOCKER-USER 방화벽 규칙을 다시 넣는다 (docs/43 §13, 2026-09-21).
#
# 왜 iptables-persistent 가 아닌가 — DOCKER-USER 체인은 **도커 데몬이 기동하며 만든다.**
#   netfilter-persistent 는 부팅 초기(도커보다 먼저) 돌아서, 아직 없는 체인에 규칙을 복원하려다
#   실패하거나 도커가 나중에 만든 규칙과 충돌한다. 그래서 순서를 도커 뒤로 두고 스크립트를 다시 돌린다.
#
# 왜 스크립트 재실행인가 — lan-firewall.sh 는 멱등하다(`iptables -C` 로 존재를 먼저 확인).
#   규칙 스냅샷을 따로 저장해 두면 스크립트와 저장본이 갈라지는 순간 어느 쪽이 진실인지 알 수 없다.
#   **진실은 한 곳(스크립트)에만 둔다.**
#
# 설치 (사용자, sudo 필요):
#   sudo cp systemd/cdc-lan-firewall.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cdc-lan-firewall
#   systemctl status cdc-lan-firewall --no-pager
[Unit]
Description=CDC pipeline LAN firewall (DOCKER-USER rules)
Documentation=file:///home/calme/cdc-realtime-pipeline/docs/43-external-watchdog.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 도커가 "기동 완료" 라고 보고한 뒤에도 DOCKER-USER 가 아직 없을 수 있다 → 체인이 생길 때까지 최대 60초 기다린다.
# 기다리지 않으면 부팅 때만 조용히 실패하고, 그 사실을 아무도 모른 채 포트가 열려 있게 된다.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do /usr/sbin/iptables -L DOCKER-USER -n >/dev/null 2>&1 && exit 0; sleep 2; done; echo "DOCKER-USER 체인이 60초 안에 생기지 않았다"; exit 1'
ExecStart=/home/calme/cdc-realtime-pipeline/scripts/ops/lan-firewall.sh

[Install]
WantedBy=multi-user.target
